{
    "name": "your-org/sscpay-gateway-aggregator",
    "description": "WordPress支付网关聚合插件",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-openssl": "*",
        "ext-json": "*",
        "yahnis-elsts/plugin-update-checker": "^5.4",
        "stripe/stripe-php": "^21.0"
    },
    "autoload": {
        "psr-4": {
            "PaymentGatewayAggregator\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
